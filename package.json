  "scripts": {
    "build": "tsdown && tsdown --config tsdown.host.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts",
    "LICENSE",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md"
  ]
}
